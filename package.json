{
  "name": "905finance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx src/db/migrate.ts --deploy && tsx src/db/seed.ts --deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "seller:activate": "tsx scripts/activate-seller.ts",
    "qatom:item": "tsx scripts/qatom-item.ts"
  },
  "dependencies": {
    "@privy-io/node": "^0.39.0",
    "@privy-io/react-auth": "^3.51.4",
    "@solana-program/memo": "^0.16.0",
    "@solana-program/system": "^0.16.0",
    "@solana-program/token": "^0.16.1",
    "@solana/kit": "^8.6.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.17",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.3.4"
}
