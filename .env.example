# ---- Database ---------------------------------------------------------------
# Local development uses the Postgres container from docker-compose.yml.
# For deployment, point this at your Neon (or other Postgres) connection string.
DATABASE_URL=postgres://nof:nof_local_dev@localhost:54329/nof905

# ---- Sessions ---------------------------------------------------------------
# Signs the application session cookie. At least 32 random characters.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# ---- Privy ------------------------------------------------------------------
# From https://dashboard.privy.io -> your app -> Settings.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ---- Development sign-in ----------------------------------------------------
# AUTH_MODE=dev enables a clearly labelled local sign-in form so the app can be
# exercised before Privy credentials exist. It is ignored unless NODE_ENV is
# "development" or "test", and the server refuses to start in production with it.
AUTH_MODE=

# ---- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Qatom (agent communication) ---------------------------------------------
# Qatom carries the messages between a buyer's agent and a seller's agent. No
# money moves through it. All four are optional: with none set, agents use the
# in-app demo channel and the seller endpoint answers nobody.
#
# The secret Qatom presents to /api/qatom/seller/<slug> on every delivery. At
# least 32 random characters (openssl rand -hex 24). Set the same value as a
# Sensitive "Authorization: Bearer <value>" header on each catalog item.
QATOM_FULFILMENT_TOKEN=
# Which Qatom catalog item carries messages to which sample seller, as
# slug:item-id pairs, for example: relay-qa:412,ledgerproof:413
QATOM_SELLER_ITEMS=
# The seller account's client credentials (Qatom dashboard > Settings > Secrets).
# With them, every delivery is confirmed with Qatom itself before it is served.
QATOM_ACCOUNT_CLIENT_ID=
QATOM_ACCOUNT_CLIENT_SECRET=

# ---- GOAT Network (seller identity and payment) -------------------------------
# Seller identity and reputation are read from GOAT Testnet3 with no settings.
# GOAT_RPC_URL may name a dedicated Testnet3 endpoint; it is checked to be
# chain 48816 before it is used.
GOAT_RPC_URL=
#
# Real wallets and payments are OFF unless every value below is set and
# GOAT_SETTLEMENT is exactly "testnet3". Testnet3 only: the production GOAT
# Flow API is refused. Privy credentials (above) are needed as well.
GOAT_SETTLEMENT=
# The USD token your GOAT Flow test merchant is configured for. The decimals
# are checked against the token contract before any amount is used.
GOAT_USD_TOKEN_ADDRESS=
GOAT_USD_TOKEN_SYMBOL=
GOAT_USD_TOKEN_DECIMALS=
# Your GOAT Flow TEST merchant (https://flow-merchant.testnet3.goat.network).
GOATX402_API_URL=https://flow-api.testnet3.goat.network
GOATX402_API_KEY=
GOATX402_API_SECRET=
GOATX402_MERCHANT_ID=
# Optional: a Privy policy attached to every engagement wallet, limiting what
# it may sign (for example: only the token contract, only chain 48816).
PRIVY_WALLET_POLICY_ID=

# ---- Purchasing agent -------------------------------------------------------
# Optional. Leave both empty and the agent is scripted: it buys each permitted
# service in turn. Set both and a language model decides what to buy, reading
# the engagement's scope. Any model served over the chat-completions interface
# works, which covers open models from hosted services and from a runner on
# your own machine. The model only proposes: the mandate still decides.
#
#   A hosted open model:   AGENT_MODEL_URL=https://<host>/v1   plus a key
#   A local runner:        AGENT_MODEL_URL=http://localhost:11434/v1   no key
#
# The address must be https unless it is this machine. The model needs to
# support tool calling.
AGENT_MODEL_URL=
AGENT_MODEL_NAME=
# The host's API key, when it asks for one. Never committed, never shown.
AGENT_MODEL_KEY=

# ---- Testing worker ---------------------------------------------------------
# Shared secret the testing worker presents to /api/worker/*. At least 32 random
# characters; generate one with: openssl rand -hex 32. Give the same value to the
# worker as WORKER_TOKEN. Leave empty to keep the worker endpoints closed.
WORKER_TOKEN=

# ---- Proof on GOAT -----------------------------------------------------------
# Every payment, funding, return, rating and verdict is given a fingerprint.
# Set this to exactly "testnet3" to also write the fingerprints to GOAT
# Testnet3, from a wallet the platform holds through Privy (the Privy
# credentials above are needed). The wallet is created on first use and its
# address is shown in Settings: send it a little test BTC for network fees.
# It never holds or moves tokens.
GOAT_PROOFS=

# ---- 905 Finance validators -------------------------------------------------
# The sign-in email addresses of the people who decide validation cases
# (problems buyers report, and ratings of one or two stars), separated by
# commas. Leave empty and nobody can: cases wait. A validator cannot decide a
# case that involves an organization they belong to.
PLATFORM_OPERATOR_EMAILS=
